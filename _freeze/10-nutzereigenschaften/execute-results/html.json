atingsystem\n\n\n::: {.cell}\n\n```{.r .cell-code}\nn_actions_searches_interactions |>\n  count(operatingsystem, sort = TRUE) |>\n  slice_head(n = 10)\n```\n\n::: {.cell-output-display}\n`````{=html}\n<div data-pagedtable=\"false\">\n  <script data-pagedtable-source type=\"application/json\">\n{\"columns\":[{\"label\":[\"operatingsystem\"],\"name\":[1],\"type\":[\"chr\"],\"align\":[\"left\"]},{\"label\":[\"n\"],\"name\":[2],\"type\":[\"int\"],\"align\":[\"right\"]}],\"data\":[{\"1\":\"Windows 10\",\"2\":\"4648\"},{\"1\":\"Mac 10.15\",\"2\":\"4645\"},{\"1\":\"Windows 11\",\"2\":\"2588\"},{\"1\":\"Android 14.0\",\"2\":\"261\"},{\"1\":\"GNU/Linux\",\"2\":\"211\"},{\"1\":\"Android 13.0\",\"2\":\"159\"},{\"1\":\"iOS 18.3\",\"2\":\"147\"},{\"1\":\"iOS 17.5\",\"2\":\"105\"},{\"1\":\"iOS 17.6\",\"2\":\"101\"},{\"1\":\"iOS 18.5\",\"2\":\"85\"}],\"options\":{\"columns\":{\"min\":{},\"max\":[10]},\"rows\":{\"min\":[10],\"max\":[10]},\"pages\":{}}}\n  </script>\n</div>\n`````\n:::\n:::\n\n\n## browsername\n\n\n\n::: {.cell}\n\n```{.r .cell-code}\nn_actions_searches_interactions |>\n  count(browsername, sort = TRUE) |>\n  slice_head(n = 10)\n```\n\n::: {.cell-output-display}\n`````{=html}\n<div data-pagedtable=\"false\">\n  <script data-pagedtable-source type=\"application/json\">\n{\"columns\":[{\"label\":[\"browsername\"],\"name\":[1],\"type\":[\"chr\"],\"align\":[\"left\"]},{\"label\":[\"n\"],\"name\":[2],\"type\":[\"int\"],\"align\":[\"right\"]}],\"data\":[{\"1\":\"Safari\",\"2\":\"4226\"},{\"1\":\"Chrome\",\"2\":\"3153\"},{\"1\":\"Firefox\",\"2\":\"2393\"},{\"1\":\"Microsoft Edge\",\"2\":\"2361\"},{\"1\":\"Mobile Safari\",\"2\":\"811\"},{\"1\":\"Chrome Mobile\",\"2\":\"218\"},{\"1\":\"Opera GX\",\"2\":\"190\"},{\"1\":\"Chrome Mobile iOS\",\"2\":\"158\"},{\"1\":\"Chrome Webview\",\"2\":\"143\"},{\"1\":\"Samsung Browser\",\"2\":\"142\"}],\"options\":{\"columns\":{\"min\":{},\"max\":[10]},\"rows\":{\"min\":[10],\"max\":[10]},\"pages\":{}}}\n  </script>\n</div>\n`````\n:::\n:::